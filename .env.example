# Copy to .env and fill in. .env is git-ignored.

# Google AI Studio key: Gemini Decision 1 (free tier, 10k requests/day).
GEMINI_API_KEY=

# Command Code key: TypeSafe Jev via /provider/v1/systemone (plan with API access).
COMMANDCODE_API_KEY=
# COMMANDCODE_MODEL=typesafe/jev

# OpenRouter key for the real judge (parallel/decisions-fast, ~$1 per 1000 turns).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=parallel/decisions-fast

# TypeSafe AI key for the Jev decision model (optional, needs paid quota).
TYPESAFE_API_KEY=

# gemini | commandcode | openrouter | jev | mock
JUDGE=mock

# Number of brain-simulation worker processes (<= CPU cores)
SIM_WORKERS=2

# Playtest only: append each turn (raw input, judge answers, fragment ids, output)
# to this JSONL file. Leave empty in production; normal logs never store input.
PLAYTEST_LOG=
